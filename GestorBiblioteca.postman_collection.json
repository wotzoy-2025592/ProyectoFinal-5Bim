          "mode": "raw",
          "raw": "{\n  \"isbn\": \"{{isbnNuevo}}\",\n  \"titulo\": \"Libro creado desde Postman\",\n  \"autor\": \"Autor Postman\",\n  \"categoria\": \"Postman\",\n  \"stockTotal\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
