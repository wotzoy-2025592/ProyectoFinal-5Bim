{
  "info": {
    "name": "Gestor de Biblioteca API",
    "description": "Ejecutar en orden (Collection Runner). Cada login guarda su JWT; cada request fija {{token}} según el rol que necesita.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "REGISTER",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Registro OK (201)\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test(\"Rol LECTOR y estado ACTIVO\", () => { pm.expect(j.rol).to.eql(\"LECTOR\"); pm.expect(j.estado).to.eql(\"ACTIVO\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Lector Postman\",\n  \"email\": \"lector{{$timestamp}}@email.com\",\n  \"password\": \"123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "LOGIN ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login OK (200)\", () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test(\"Devuelve JWT sin password\", () => { pm.expect(json.token).to.be.a(\"string\"); pm.expect(json).to.not.have.property(\"password\"); });",
              "pm.collectionVariables.set(\"tokenAdmin\", json.token);",
              "pm.collectionVariables.set(\"token\", json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
